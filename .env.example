# Firebase web config (Project settings > Your apps > Web app). These values are
# public by design; access is controlled by Firebase Authentication rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Welcome email for new accounts (https://www.emailjs.com, free tier).
# Template variables: {{to_email}}, {{to_name}}, {{app_url}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Tourain AI (Firebase AI Logic, Gemini Developer API — free on Spark)
VITE_GEMINI_MODEL=gemini-3.8-flash
# App Check: reCAPTCHA v3 site key for the live site
# reCAPTCHA Enterprise site key (preferred) — public, safe in the browser
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# or a reCAPTCHA v3 site key
VITE_RECAPTCHA_SITE_KEY=
# App Check debug token for localhost (Firebase console > App Check > Manage debug tokens)
VITE_APPCHECK_DEBUG_TOKEN=
